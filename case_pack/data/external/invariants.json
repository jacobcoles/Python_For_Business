{
  "about": "Documented expected invariants for the OECD external-context snapshot. Two groups, deliberately separated.",

  "frozen_snapshot_assertions": {
    "why_this_group_exists": "These assert exact values against the cached raw snapshot in raw/, which is a fixed set of bytes that never changes, so pinning precise numbers here is safe and gives the course a reproducible oracle.",
    "applies_to": "raw/oecd_prices_c2018_hicp_swe_ea.sdmx.json and the oecd_context_tidy.csv parsed from it",
    "must_never_be_run_against_a_live_response": true,
    "assertions": [
      { "id": "F01", "check": "raw_file_sha256", "expected": "570e197210c304a433621cb934b3416fbd9cfd47841133741dfb555cd78775d0" },
      { "id": "F02", "check": "raw_file_bytes", "expected": 27147 },
      { "id": "F03", "check": "tidy_csv_sha256_with_retrieved_at_utc_replaced_by_RETRIEVED_AT_PLACEHOLDER", "expected": "b4275d50cef0bfb97a6ffc45cc64726af6ebfd4074c7ee8e63538d26cd136624" },
      { "id": "F04", "check": "row_count", "expected": 50 },
      { "id": "F05", "check": "distinct_series_keys", "expected": ["EA.M.HICP.CPI.PA._T.N.GY", "SWE.M.HICP.CPI.PA._T.N.GY"] },
      { "id": "F06", "check": "period_min", "expected": "2024-01" },
      { "id": "F07", "check": "period_max", "expected": "2026-01" },
      { "id": "F08", "check": "rows_per_series_key", "expected": { "EA.M.HICP.CPI.PA._T.N.GY": 25, "SWE.M.HICP.CPI.PA._T.N.GY": 25 } },
      { "id": "F09", "check": "observation_value", "where": { "ref_area": "SWE", "period": "2025-12" }, "expected": 2.1,
        "note": "Northbridge base reporting period." },
      { "id": "F10", "check": "observation_value", "where": { "ref_area": "SWE", "period": "2026-01" }, "expected": 2.0,
        "note": "Northbridge rerun period." },
      { "id": "F11", "check": "observation_value", "where": { "ref_area": "EA", "period": "2025-12" }, "expected": 2.0 },
      { "id": "F12", "check": "observation_value", "where": { "ref_area": "EA", "period": "2026-01" }, "expected": 1.7 },
      { "id": "F13", "check": "observation_value", "where": { "ref_area": "SWE", "period": "2024-01" }, "expected": 3.4,
        "note": "First period of the window." },
      { "id": "F14", "check": "observation_value", "where": { "ref_area": "EA", "period": "2024-01" }, "expected": 2.8 },
      { "id": "F15", "check": "value_min_max_by_ref_area", "expected": { "EA": [1.7, 2.8], "SWE": [1.2, 3.4] } },
      { "id": "F16", "check": "sum_of_all_values_rounded_10dp", "expected": 113.0,
        "note": "One number that changes if any single observation changes." },
      { "id": "F17", "check": "all_obs_status_codes", "expected": ["A"] },
      { "id": "F18", "check": "distinct_retrieved_at_utc", "expected": ["2026-09-13T18:33:16Z"] }
    ]
  },

  "live_assertions": {
    "why_this_group_exists": "These assert only schema, meaning and structural invariants, so a legitimate OECD revision to a published figure (or one more month of data being released) leaves them all passing; they catch the failures that actually matter - a broken query, a renamed dimension, a changed unit, duplicated rows - without ever pinning a number the statistical agency is entitled to change.",
    "applies_to": "any fresh live response from the adopted query, now or in future",
    "must_not_contain_exact_observation_values": true,
    "assertions": [
      { "id": "L01", "check": "http_status_is", "expected": 200 },
      { "id": "L02", "check": "response_content_type_contains", "expected": "application/vnd.sdmx.data+json",
        "note": "Checked BEFORE parsing. The OECD error path returns text/plain." },
      { "id": "L03", "check": "body_parses_as_json_and_has_path", "expected": ["data.structures[0].dimensions.observation", "data.dataSets[0]"] },
      { "id": "L04", "check": "observations_present_and_non_empty", "expected": true,
        "note": "A valid-but-empty query returns HTTP 200 with \"observations\": null. That is an empty result, not a transport failure." },
      { "id": "L05", "check": "tidy_columns_exactly_and_in_order", "expected": ["ref_area", "ref_area_name", "frequency", "frequency_name", "methodology", "methodology_name", "measure", "measure_name", "unit_measure", "unit_label", "expenditure", "expenditure_name", "adjustment", "adjustment_name", "transformation", "transformation_name", "series_key", "period", "value", "obs_status", "obs_status_name", "source_id", "dataflow_id", "query_url", "retrieved_at_utc"] },
      { "id": "L06", "check": "unique_on", "expected": ["series_key", "period"], "note": "Zero duplicate keys, including across reruns." },
      { "id": "L07", "check": "no_nulls_in_required_columns", "expected": ["ref_area", "ref_area_name", "frequency", "methodology", "measure", "unit_measure", "unit_label", "transformation", "series_key", "period", "value", "source_id", "dataflow_id", "query_url", "retrieved_at_utc"] },
      { "id": "L08", "check": "every_row_has_frequency", "expected": "M", "decoded": "Monthly" },
      { "id": "L09", "check": "every_row_has_unit_measure", "expected": "PA", "decoded": "Percent per annum",
        "note": "Guards against a silent switch to index levels (IX)." },
      { "id": "L10", "check": "every_row_has_transformation", "expected": "GY", "decoded": "Growth rate, over 1 year" },
      { "id": "L11", "check": "every_row_has_methodology", "expected": "HICP", "decoded": "Eurostat harmonised index of consumer prices (HICP)",
        "note": "Guards against silently picking up the national CPI, which is a different statistic." },
      { "id": "L12", "check": "every_row_has_measure", "expected": "CPI", "decoded": "Consumer price index" },
      { "id": "L13", "check": "every_row_has_expenditure", "expected": "_T", "decoded": "Total" },
      { "id": "L14", "check": "every_row_has_adjustment", "expected": "N", "decoded": "Neither seasonally adjusted nor calendar adjusted" },
      { "id": "L15", "check": "ref_area_set_equals", "expected": ["EA", "SWE"] },
      { "id": "L16", "check": "value_is_finite_number", "expected": true },
      { "id": "L17", "check": "value_within_plausible_band_percent_per_annum", "expected": [-50.0, 100.0],
        "note": "A sanity band, not a forecast. It catches a unit or scale change (e.g. index levels around 120), not a revision." },
      { "id": "L18", "check": "period_matches_regex", "expected": "^[0-9]{4}-(0[1-9]|1[0-2])$", "note": "ISO YYYY-MM." },
      { "id": "L19", "check": "every_period_within_requested_window", "expected": ["2024-01", "2026-01"] },
      { "id": "L20", "check": "requested_window_fully_covered", "expected": { "period_min": "2024-01", "period_max": "2026-01" },
        "note": "The window is entirely historical, so both series should still cover it in full after any revision." },
      { "id": "L21", "check": "no_gaps_in_monthly_sequence_per_series", "expected": true },
      { "id": "L22", "check": "row_count_equals_series_count_times_months_in_window", "expected": true,
        "note": "Derived from L20 and L21 (2 series x 25 months = 50). Stated as a relationship, not as the literal 50, so it stays true if the window parameter is changed." },
      { "id": "L23", "check": "retrieved_at_utc_is_iso8601_utc_and_identical_on_every_row", "expected": true },
      { "id": "L24", "check": "retrieved_at_utc_is_later_than_period_max", "expected": true,
        "note": "Observation period and retrieval timestamp are different things and must never be conflated." },
      { "id": "L25", "check": "query_url_identical_on_every_row_and_contains", "expected": "DSD_PRICES_COICOP2018@DF_PRICES_C2018_ALL" },
      { "id": "L26", "check": "source_id_equals", "expected": "OECD.SDD.TPS" }
    ]
  }
}
